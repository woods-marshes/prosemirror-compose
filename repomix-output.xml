    public var linkTextDecoration: TextDecoration by mutableStateOf(TextDecoration.Underline)
    public var codeSpanColor: Color by mutableStateOf(Color(0xFFD63384))
    public var codeSpanBackgroundColor: Color by mutableStateOf(Color.LightGray.copy(alpha = 0.3f))
    public var codeSpanStrokeColor: Color by mutableStateOf(Color.LightGray.copy(alpha = 0.8f))

    // 列表的基准缩进像素值
    public var listIndent: Dp by mutableStateOf(32.dp)
}
