<file path="src/commonMain/kotlin/com/github/wood/prosemirror/compose/utils/DocumentCompiler.kt">
package com.github.wood.prosemirror.compose.utils

import androidx.compose.foundation.Image
import androidx.compose.foundation.layout.fillMaxSize
import androidx.compose.foundation.text.InlineTextContent
import androidx.compose.foundation.text.appendInlineContent
import androidx.compose.runtime.LaunchedEffect
import androidx.compose.runtime.getValue
import androidx.compose.runtime.mutableStateOf
import androidx.compose.runtime.setValue
import androidx.compose.ui.geometry.isUnspecified
import androidx.compose.ui.platform.LocalDensity
import androidx.compose.ui.text.AnnotatedString
import androidx.compose.ui.text.Placeholder
import androidx.compose.ui.text.PlaceholderVerticalAlign
import androidx.compose.ui.text.SpanStyle
import androidx.compose.ui.text.TextRange
import androidx.compose.ui.unit.TextUnit
import androidx.compose.ui.unit.sp
import com.atlassian.prosemirror.model.Node
import com.atlassian.prosemirror.model.Schema
import com.github.wood.prosemirror.compose.model.ImageData
import com.github.wood.prosemirror.compose.model.LocalImageLoader
import com.github.wood.prosemirror.compose.model.LocalRichTextMaxImageWidthProvider
import com.github.wood.prosemirror.compose.model.clampToMaxWidth
import com.github.wood.prosemirror.compose.model.ProseMirrorConfig

private val imageResolvedDimensionsCache = mutableMapOf<String, Pair<TextUnit, TextUnit>>()
public class DocumentCompiler(
    private val schema: Schema,
    private val config: ProseMirrorConfig? = null,
    private val onInlineContentUpdate: (() -> Unit)? = null
) {
    private val builder = AnnotatedString.Builder()
    private val mapBuilder = PositionCoordinateMapBuilder()
    private val inlineContentMap = mutableMapOf<String, InlineTextContent>()
    private val customDrawRanges = mutableListOf<CustomDrawRange>()

    public fun compile(doc: Node): CompiledDocument {
        mapBuilder.registerBoundary(pmPos = 0, flatPos = 0)
        compileNode(doc, currentPmPos = 0)
        mapBuilder.registerBoundary(pmPos = doc.nodeSize, flatPos = builder.length)
        return CompiledDocument(
            builder.toAnnotatedString(),
            mapBuilder.build(),
            inlineContentMap,
            customDrawRanges
        )
    }

    private fun compileNode(node: Node, currentPmPos: Int): Int {
        var pmCursor = currentPmPos

        if (node.isText) {
            val textValue = node.text ?: ""
            val flatStart = builder.length
            val flatEnd = flatStart + textValue.length

            mapBuilder.registerRange(
                pmStart = pmCursor,
                pmEnd = pmCursor + node.nodeSize,
                flatStart = flatStart,
                flatEnd = flatEnd
            )

            val hasCode = node.marks.any { it.type.name == "code" }
            if (hasCode) {
                customDrawRanges.add(
                    CustomDrawRange(TextRange(flatStart, flatEnd), CustomDrawStyle.CodePill())
                )
            }

            val mergedStyle = node.marks
                .map { mark -> MarkMapper.map(mark, config) }
                .fold(SpanStyle()) { acc, style -> acc.merge(style) }

            builder.pushStyle(mergedStyle)

            // 为超链接注册 StringAnnotation 以便支持响应式点击
            val linkMark = node.marks.firstOrNull { it.type.name == "link" }
            if (linkMark != null) {
                val href = linkMark.attrs["href"] as? String ?: ""
                builder.addStringAnnotation("URL", href, flatStart, flatEnd)
            }

            builder.append(textValue)
            builder.pop()

            return pmCursor + node.nodeSize
        }

        val isBlock = node.isBlock
        val isLeaf = node.isLeaf
        val isDoc = node.type == schema.topNodeType

        // 处理既是 Block 又是 Leaf 的节点（如 horizontal_rule）
        // 对于这类节点，只累加一次 nodeSize，避免坐标计算错误
        if (isBlock && !isDoc && !isLeaf) {
            // 进入 Block 节点，结构位置前进 1 (即开标签位)
            pmCursor += 1
            if (builder.length > 0 && builder.toAnnotatedString().text.last() != '\n') {
                builder.append("\n")
            }
            mapBuilder.registerBoundary(pmPos = pmCursor, flatPos = builder.length)
        }

        if (isLeaf) {
            // 调用 registerInlineNode 挂载图片/换行
            registerInlineNode(node, pmCursor)
            // 对于既是 Block 又是 Leaf 的节点，nodeSize 已经包含了开闭标签
            pmCursor += node.nodeSize
        } else {
            // 递归处理非叶子节点的子元素（包括行内元素）
            node.content.forEach { child, _, _ ->
                pmCursor = compileNode(child, pmCursor)
            }
        }

        if (isBlock && !isDoc && !isLeaf) {
            // 退出 Block 节点，结构位置前进 1 (即闭标签位)
            pmCursor += 1
            mapBuilder.registerBoundary(pmPos = pmCursor, flatPos = builder.length)
        }

        return pmCursor
    }

    @Suppress("UNUSED_PARAMETER")
    private fun registerInlineNode(node: Node, pmPos: Int) {
        val index = inlineContentMap.size
        when {
            // 匹配硬换行节点
            node.type.name == "hard_break" || node.type.spec.linebreakReplacement == true -> {
                val flatStart = builder.length
                builder.append("\n")
                mapBuilder.registerRange(pmPos, pmPos + 1, flatStart, flatStart + 1)
            }

            // 匹配图片节点 (支持自定义类型名称)
            node.type.name == "image" || node.type.isInGroup("inline") && node.attrs.containsKey("src") -> {
                val src = node.attrs["src"] as? String ?: ""
                val alt = node.attrs["alt"] as? String ?: ""
                val tagId = "inline_img_${index}_${src.hashCode()}"
                val flatStart = builder.length

                // 写入 Compose InlineContent 占位符
                builder.appendInlineContent(id = tagId, alternateText = alt)
                mapBuilder.registerRange(pmPos, pmPos + 1, flatStart, flatStart + 1)

                // 借助组件内部的 State 动态计算宽高，并响应式渲染
                inlineContentMap[tagId] = createResponsiveImageInlineContent(src, alt)
            }
        }
    }

    /**
     * 构建具备自适应等比缩放与防闪烁能力的 Image InlineContent
     */
    private fun createResponsiveImageInlineContent(src: String, alt: String): InlineTextContent {
        // 初始预留的默认占位宽高
        var currentWidth by mutableStateOf(120.sp)
        var currentHeight by mutableStateOf(80.sp)

        return InlineTextContent(
            placeholder = Placeholder(
                width = currentWidth,
                height = currentHeight,
                placeholderVerticalAlign = PlaceholderVerticalAlign.Center
            )
        ) {
            val density = LocalDensity.current
            val imageLoader = LocalImageLoader.current
            val maxImageWidth = LocalRichTextMaxImageWidthProvider.current.maxWidth
            val imageData: ImageData? = imageLoader.load(src)

            if (imageData != null) {
                val intrinsicSize = imageData.painter.intrinsicSize

                // 监听 Painter 测量完成，动态调整 Placeholder 的宽高比
                LaunchedEffect(src, intrinsicSize, maxImageWidth) {
                    if (intrinsicSize.isUnspecified) return@LaunchedEffect

                    val intrinsicWidth = with(density) { intrinsicSize.width.coerceAtLeast(0f).toSp() }
                    val intrinsicHeight = with(density) { intrinsicSize.height.coerceAtLeast(0f).toSp() }

                    val (clampedW, clampedH) = clampToMaxWidth(
                        width = intrinsicWidth,
                        height = intrinsicHeight,
                        maxWidth = maxImageWidth
                    )

                    // 只有在尺寸真正变化时才更新，避免不必要的重组
                    if (currentWidth != clampedW || currentHeight != clampedH) {
                        currentWidth = clampedW
                        currentHeight = clampedH
                        // 通知 ProseMirrorState 重新注册 inlineContentMap
                        // 这样可以触发 Placeholder 的重新测量
                        onInlineContentUpdate?.invoke()
                    }
                }

                Image(
                    painter = imageData.painter,
                    contentDescription = imageData.contentDescription ?: alt,
                    alignment = imageData.alignment,
                    contentScale = imageData.contentScale,
                    modifier = imageData.modifier.fillMaxSize()
                )
            }
        }
    }

    /**
     * 注册行内图片节点
     */
    private fun registerImageInlineNode(node: Node, pmPos: Int) {
        val src = node.attrs["src"] as? String ?: ""
        val alt = node.attrs["alt"] as? String ?: ""

        // 生成稳定的 TagID
        val tagId = "pm_img_${pmPos}_${src.hashCode()}"
        val flatStart = builder.length

        // 写入占位符字符 \uFFFD
        builder.appendInlineContent(id = tagId, alternateText = alt)
        mapBuilder.registerRange(pmPos, pmPos + 1, flatStart, flatStart + 1)

        // 读取节点的初始宽高属性或全局缓存
        val cachedDims = imageResolvedDimensionsCache[src]
        val initialWidth = cachedDims?.first ?: (node.attrs["width"] as? Number)?.toFloat()?.sp ?: 120.sp
        val initialHeight = cachedDims?.second ?: (node.attrs["height"] as? Number)?.toFloat()?.sp ?: 80.sp

        // 注册/构建带有刷新回调能力的 InlineTextContent
        state.registerInlineContent(
            id = tagId,
            content = createResponsiveImageInlineContent(tagId, src, alt, initialWidth, initialHeight)
        )
    }

    /**
     * 构建具备防闪烁、等比裁剪、并能强行触发 BasicText 重新测量的 InlineTextContent
     */
    private fun createResponsiveImageInlineContent(
        tagId: String,
        src: String,
        alt: String,
        currentWidth: TextUnit,
        currentHeight: TextUnit
    ): InlineTextContent {
        return InlineTextContent(
            placeholder = Placeholder(
                width = currentWidth.value.coerceAtLeast(0f).sp,
                height = currentHeight.value.coerceAtLeast(0f).sp,
                placeholderVerticalAlign = PlaceholderVerticalAlign.Center
            ),
            children = {
                val density = LocalDensity.current
                val imageLoader = LocalImageLoader.current
                val maxImageWidth = LocalRichTextMaxImageWidthProvider.current.maxWidth
                val imageData: ImageData? = imageLoader.load(src)

                if (imageData != null) {
                    val intrinsicSize = imageData.painter.intrinsicSize

                    LaunchedEffect(src, intrinsicSize, maxImageWidth) {
                        if (intrinsicSize.isUnspecified) return@LaunchedEffect

                        val intrinsicWidth = with(density) { intrinsicSize.width.coerceAtLeast(0f).toSp() }
                        val intrinsicHeight = with(density) { intrinsicSize.height.coerceAtLeast(0f).toSp() }

                        val (clampedW, clampedH) = clampToMaxWidth(
                            width = intrinsicWidth,
                            height = intrinsicHeight,
                            maxWidth = maxImageWidth
                        )

                        if (currentWidth == clampedW && currentHeight == clampedH) return@LaunchedEffect

                        // 1. 存入内存缓存
                        imageResolvedDimensionsCache[src] = clampedW to clampedH

                        // 2. 【核心】：调用 state.registerInlineContent，用重新构建的带新 Placeholder 的对象
                        //    覆盖 map[tagId]，强行让 BasicText 重新测量占位框！
                        state.registerInlineContent(
                            id = tagId,
                            content = createResponsiveImageInlineContent(
                                tagId = tagId,
                                src = src,
                                alt = alt,
                                currentWidth = clampedW,
                                currentHeight = clampedH
                            )
                        )
                    }

                    Image(
                        painter = imageData.painter,
                        contentDescription = imageData.contentDescription ?: alt,
                        alignment = imageData.alignment,
                        contentScale = imageData.contentScale,
                        modifier = imageData.modifier.fillMaxSize()
                    )
                }
            }
        )
    }
}
</file>

