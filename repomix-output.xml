package com.github.wood.prosemirror.compose.model

import androidx.compose.foundation.text.InlineTextContent
import androidx.compose.runtime.Stable
import androidx.compose.runtime.getValue
import androidx.compose.runtime.mutableStateOf
import androidx.compose.runtime.setValue
import androidx.compose.ui.text.AnnotatedString
import androidx.compose.ui.text.TextLayoutResult
import androidx.compose.ui.text.TextRange
import androidx.compose.ui.text.input.TextFieldValue
import com.atlassian.prosemirror.history.redo
import com.atlassian.prosemirror.history.redoDepth
import com.atlassian.prosemirror.history.undo
import com.atlassian.prosemirror.history.undoDepth
import com.atlassian.prosemirror.model.Attrs
import com.atlassian.prosemirror.model.DOMParser
import com.atlassian.prosemirror.model.DOMSerializer
import com.atlassian.prosemirror.model.Mark
import com.atlassian.prosemirror.model.MarkType
import com.atlassian.prosemirror.model.Node
import com.atlassian.prosemirror.model.NodeType
import com.atlassian.prosemirror.model.Schema
import com.atlassian.prosemirror.state.EmptyEditorStateConfig
import com.atlassian.prosemirror.state.PMEditorState
import com.atlassian.prosemirror.state.Plugin
import com.atlassian.prosemirror.state.TextSelection
import com.atlassian.prosemirror.state.Transaction
import com.atlassian.prosemirror.transform.setBlockType
import com.github.wood.prosemirror.compose.utils.CustomDrawRange
import com.github.wood.prosemirror.compose.utils.DocumentCompiler
import com.github.wood.prosemirror.compose.utils.PositionCoordinateMap
import com.github.wood.prosemirror.compose.utils.calculateTextDiff

@Stable
public class ProseMirrorState(
    public val schema: Schema,
    initialDoc: Node,
    plugins: List<Plugin<*>> = emptyList(),
    public val config: ProseMirrorConfig = ProseMirrorConfig()
) {
    // 底层持有的、Atlassian 的核心不可变编辑器状态
    public var editorState: PMEditorState by mutableStateOf(
        PMEditorState.create(
            EmptyEditorStateConfig(schema = schema, doc = initialDoc, plugins = plugins)
        )
    )
        private set

    // 带有样式的扁平 AnnotatedString 缓存
    public var annotatedString: AnnotatedString by mutableStateOf(AnnotatedString(""))
        private set

    // 与 BasicTextField 绑定的数据源
    public var textFieldValue by mutableStateOf(TextFieldValue())
        private set

    // 图片等原子行内节点的占位画笔集
    public var inlineContentMap: Map<String, InlineTextContent> by mutableStateOf(emptyMap())
        private set

    // 跟踪当前使用的 inline content keys，用于清理未使用的条目
    public val usedInlineContentMapKeys: MutableSet<String> = mutableSetOf()

    public val doc: Node
        get() = editorState.doc

    public var customDrawRanges: List<CustomDrawRange> by mutableStateOf(emptyList())
        private set

    public var textLayoutResult: TextLayoutResult? by mutableStateOf(null)
        public set

    private var coordinateMap: PositionCoordinateMap = PositionCoordinateMap.EMPTY


    init {
        compileState(editorState)
    }

    private fun compileState(state: PMEditorState) {
        val compiler = DocumentCompiler(
            schema = schema,
            config = config,
            onInlineContentUpdate = {
                // 当图片尺寸变化时，重新编译以更新 inlineContentMap
                recompileState()
            }
        )
        val compiled = compiler.compile(state.doc)

        this.coordinateMap = compiled.coordinateMap
        this.annotatedString = compiled.annotatedString
        this.inlineContentMap = compiled.inlineContentMap
        this.customDrawRanges = compiled.customDrawRanges

        val flatSelectionStart = coordinateMap.pmToFlat(state.selection.anchor)
        val flatSelectionEnd = coordinateMap.pmToFlat(state.selection.head)

        this.textFieldValue = TextFieldValue(
            annotatedString = compiled.annotatedString,
            selection = TextRange(flatSelectionStart, flatSelectionEnd)
        )
    }

    /**
     * 重新编译当前文档状态（用于图片尺寸变化等场景）
     */
    private fun recompileState() {
        compileState(editorState)
    }

    public fun dispatch(transaction: Transaction) {
        val nextState = editorState.apply(transaction)
        if (nextState != editorState) {
            editorState = nextState
            compileState(nextState)
        }
    }

    public fun onTextFieldValueChange(newValue: TextFieldValue) {
        val oldValue = textFieldValue
        val tr = editorState.tr

        if (newValue.text != oldValue.text) {
            // A. 侦测文本编辑情况并转化为 ProseMirror Steps
            val diff = calculateTextDiff(
                oldValue.text,
                newValue.text,
            )
            if (diff != null) {
                val pmFrom = coordinateMap.flatToPm(diff.start)
                val pmTo = coordinateMap.flatToPm(diff.end)

                if (diff.text.isNotEmpty()) {
                    tr.insertText(diff.text, pmFrom, pmTo)
                } else {
                    tr.delete(pmFrom, pmTo)
                }
            }

            // B. 同步最新的光标及选区
            val pmAnchor = coordinateMap.flatToPm(newValue.selection.start)
            val pmHead = coordinateMap.flatToPm(newValue.selection.end)
            tr.setSelection(TextSelection.create(tr.doc, pmAnchor, pmHead))
            dispatch(tr)
        } else if (newValue.selection != oldValue.selection) {
            // C. 纯选区或光标位置移动
            val pmAnchor = coordinateMap.flatToPm(newValue.selection.start)
            val pmHead = coordinateMap.flatToPm(newValue.selection.end)
            tr.setSelection(TextSelection.create(tr.doc, pmAnchor, pmHead))
            dispatch(tr)
        }
    }

    /**
     * 将 Compose 扁平字符索引转换为 ProseMirror 内部结构坐标
     */
    public fun flatToPm(flatPos: Int): Int {
        return coordinateMap.flatToPm(flatPos)
    }

    /**
     * 将 ProseMirror 内部结构坐标转换为 Compose 扁平字符索引
     */
    public fun pmToFlat(pmPos: Int): Int {
        return coordinateMap.pmToFlat(pmPos)
    }

    /**
     * 获取当前光标位置或选区中含有的所有活跃 Marks
     */
    public val activeMarks: List<Mark>
        get() {
            val selection = editorState.selection
            return if (selection.empty) {
                editorState.storedMarks ?: selection._from.marks()
            } else {
                selection._from.marksAcross(selection._to) ?: emptyList()
            }
        }

    /**
     * 判断某种 Mark 类型在当前选区或光标处是否处于激活状态
     */
    public fun hasMark(markType: MarkType): Boolean {
        val selection = editorState.selection
        return if (selection.empty) {
            markType.isInSet(activeMarks) != null
        } else {
            doc.rangeHasMark(selection.from, selection.to, markType)
        }
    }

    // --- 行内样式操作 (Mark Controls) ---

    /**
     * 切换行内样式（如粗体、斜体、链接、行内代码）
     */
    public fun toggleMark(markType: MarkType, attrs: Attrs? = null) {
        val tr = editorState.tr
        val selection = editorState.selection
        if (selection.empty) {
            val currentMarks = tr.storedMarks ?: selection._from.marks()
            val hasMark = markType.isInSet(currentMarks) != null
            if (hasMark) {
                tr.removeStoredMark(markType)
            } else {
                tr.addStoredMark(markType.create(attrs))
            }
        } else {
            val hasMark = doc.rangeHasMark(selection.from, selection.to, markType)
            if (hasMark) {
                tr.removeMark(selection.from, selection.to, markType)
            } else {
                tr.addMark(selection.from, selection.to, markType.create(attrs))
            }
        }
        dispatch(tr)
    }

    // --- 块级样式操作 (Block Controls) ---

    /**
     * 将当前选区内的段落转换为指定的块级类型 (如 Heading, Paragraph, CodeBlock)
     */
    public fun setBlockType(nodeType: NodeType, attrs: Attrs? = null) {
        val tr = editorState.tr
        val selection = editorState.selection
        setBlockType(tr, selection.from, selection.to, nodeType, attrs)
        dispatch(tr)
    }

    // --- 历史记录接口 (History Delegation) ---

    public val canUndo: Boolean
        get() = undoDepth(editorState) > 0

    public val canRedo: Boolean
        get() = redoDepth(editorState) > 0

    public fun undo() {
        undo(editorState) { dispatch(it) }
    }

    public fun redo() {
        redo(editorState) { dispatch(it) }
    }

    // --- 导入导出序列化 (Serializers) ---

    /**
     * 导出为符合 HTML 规范的字符串 [1]
     */
    public fun toHtml(): String {
        return DOMSerializer.fromSchema(schema).serializeFragmentToHtml(doc.content)
    }

    /**
     * 从 HTML 导入内容
     */
    public fun setHtml(html: String) {
        val newDoc = DOMParser.fromSchema(schema).parseHtml(html)
        val tr = editorState.tr
        tr.replaceWith(0, doc.content.size, newDoc.content)
        dispatch(tr)
    }

    /**
     * 导出为纯文本
     */
    public fun toText(): String {
        return doc.textContent
    }
}
</file>

